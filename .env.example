# Paddle (client — browser)
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here

# Paddle (server — never expose in client code)
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_your_key_here
PADDLE_WEBHOOK_SECRET=ntfset_your_webhook_signing_secret_here

# Auth (signed session cookie for /account)
SESSION_SECRET=generate_a_long_random_string_here

# Database (Supabase via Vercel — POSTGRES_URL is auto-synced when connected)
POSTGRES_URL=postgres://...

# Optional: one-time full Paddle → Postgres sync via POST /api/admin/sync-paddle
# Authorization: Bearer <SYNC_SECRET>
SYNC_SECRET=generate_a_long_random_string_here

# Optional: prefill checkout email when a customer is signed in via /login
