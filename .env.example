# Paddle — required (never default the environment)
# Use "sandbox" for development; switch to "production" only after Paddle verification.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Client-side token from Paddle → Developer tools → Authentication (sandbox: test_… prefix)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Server-side API key (sandbox: contains _sdbx). Never expose in client code.
PADDLE_API_KEY=

# Monthly / annual price IDs (pri_…) from your Paddle catalog — see scripts/setup-paddle-catalog.sh
NEXT_PUBLIC_PADDLE_PRICE_BASICA_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_BASICA_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_SEO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_SEO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_AUTOMATIZAR_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_AUTOMATIZAR_YEAR=

# Optional: set iago_customer_email cookie to test checkout email prefill
