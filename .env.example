# Paddle (client — browser)
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Sandbox: test_...  |  Live: live_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here

# Paddle (server — never expose in client code)
PADDLE_ENVIRONMENT=sandbox
# Sandbox: pdl_sdbx_apikey_...  |  Live: pdl_live_apikey_...
PADDLE_API_KEY=pdl_sdbx_apikey_your_key_here
PADDLE_WEBHOOK_SECRET=ntfset_your_webhook_signing_secret_here

# Live catalog price IDs (required when PADDLE_ENVIRONMENT=production)
# Easiest (iPad-friendly): one JSON variable from /admin/live-catalog
PADDLE_LIVE_CATALOG_JSON={"basico":{"month":"pri_...","year":"pri_...","developmentFee":"pri_..."},"seo":{"month":"pri_...","year":"pri_...","developmentFee":"pri_..."},"ia":{"month":"pri_...","year":"pri_...","developmentFee":"pri_..."}}

# Alternative: nine separate variables (or use scripts/create-paddle-catalog-live.sh)
PADDLE_PRICE_BASICO_MONTH=pri_live_basico_month
PADDLE_PRICE_BASICO_YEAR=pri_live_basico_year
PADDLE_PRICE_BASICO_DEV=pri_live_basico_dev
PADDLE_PRICE_SEO_MONTH=pri_live_seo_month
PADDLE_PRICE_SEO_YEAR=pri_live_seo_year
PADDLE_PRICE_SEO_DEV=pri_live_seo_dev
PADDLE_PRICE_IA_MONTH=pri_live_ia_month
PADDLE_PRICE_IA_YEAR=pri_live_ia_year
PADDLE_PRICE_IA_DEV=pri_live_ia_dev

# Auth (signed session cookie for /account)
SESSION_SECRET=generate_a_long_random_string_here

# Database (Supabase via Vercel — POSTGRES_URL is auto-synced when connected)
POSTGRES_URL=postgres://...

# Optional: one-time full Paddle → Postgres sync via POST /api/admin/sync-paddle
# Authorization: Bearer <SYNC_SECRET>
SYNC_SECRET=generate_a_long_random_string_here

# Optional: prefill checkout email when a customer is signed in via /login
