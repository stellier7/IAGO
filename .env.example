# Paddle (sandbox)
# Required — app throws if either is missing
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token_here

# Server-only — never expose in client code
PADDLE_API_KEY=pdl_sdbx_apikey_your_key_here

# Optional: prefill checkout email when a customer is signed in
# Set this cookie from your auth provider after login
# customer_email=user@example.com
